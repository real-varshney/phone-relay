{
  "manifest_version": 3,
  "name": "Phone Relay",
  "version": "0.7.3",
  "description": "Browse blocked sites through the phone — open them from the relay portal.",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "cookies",
    "storage",
    "scripting",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:3000/*", "http://localhost:3000/*"],
  "action": {
    "default_title": "Phone Relay",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:3000/portal*", "http://localhost:3000/portal*"],
      "js": ["portal-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
