# Copy this file to .env and uncomment what you need.

# Public HTTPS URL for QR codes and the Android app (no trailing slash).
# Use when the phone is NOT on the same Wi-Fi as the laptop.
# PUBLIC_URL=https://your-tunnel-3000.inc1.devtunnels.ms

# Pin the LAN IP shown on the dashboard (if it picks WSL/Hyper-V/VPN instead of Wi-Fi).
# RELAY_LAN_IP=192.168.1.42

# Windows launcher: start Dev Tunnel automatically (requires devtunnel CLI).
# USE_DEV_TUNNEL=1
